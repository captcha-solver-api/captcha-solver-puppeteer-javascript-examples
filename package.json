{
  "name": "captcha-solver-puppeteer-javascript-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Captcha Solver browser automation examples using JavaScript and Puppeteer",
  "keywords": [
    "captcha",
    "captcha-solver",
    "puppeteer",
    "browser-automation",
    "recaptcha",
    "turnstile",
    "geetest",
    "yandex-smartcaptcha",
    "tencent-captcha",
    "image-to-text",
    "javascript",
    "examples"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "recaptcha-v2": "node --env-file-if-exists=.env examples/recaptcha-v2.js",
    "recaptcha-v2-enterprise": "node --env-file-if-exists=.env examples/recaptcha-v2-enterprise.js",
    "recaptcha-v3": "node --env-file-if-exists=.env examples/recaptcha-v3.js",
    "turnstile": "node --env-file-if-exists=.env examples/turnstile.js",
    "turnstile-challenge": "node --env-file-if-exists=.env examples/turnstile-challenge.js",
    "tencent": "node --env-file-if-exists=.env examples/tencent.js",
    "yandex": "node --env-file-if-exists=.env examples/yandex-smartcaptcha.js",
    "yandex-image": "node --env-file-if-exists=.env examples/yandex-smartcaptcha-image.js",
    "image-to-text": "node --env-file-if-exists=.env examples/image-to-text.js",
    "coordinates": "node --env-file-if-exists=.env examples/coordinates.js",
    "geetest-v3": "node --env-file-if-exists=.env examples/geetest-v3.js",
    "geetest-v4": "node --env-file-if-exists=.env examples/geetest-v4.js",
    "balance": "node --env-file-if-exists=.env examples/balance.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && node scripts/check.js && npm test",
    "test": "node --test tests/*.test.js",
    "test:live": "node --env-file-if-exists=.env scripts/live.js"
  },
  "dependencies": {
    "@captcha-solver-api/javascript-sdk": "^1.1.0",
    "puppeteer": "^25.13.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/captcha-solver-api/captcha-solver-puppeteer-javascript-examples"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^61.4.1",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "zod": "4.6.6"
  }
}
