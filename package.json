{
  "name": "captcha-solver-puppeteer-javascript-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Captcha Solver browser automation examples using JavaScript and Puppeteer",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "example:recaptcha-v2": "node examples/recaptcha_v2.js",
    "example:recaptcha-v2-proxy": "node examples/recaptcha_v2_proxy.js",
    "example:callback": "node examples/recaptcha_v2_callback_variant1.js",
    "example:callback-auto": "node examples/recaptcha_v2_callback_variant2.js",
    "example:callback-proxy": "node examples/recaptcha_v2_callback_proxy.js",
    "example:recaptcha-v3": "node examples/recaptcha_v3.js",
    "example:recaptcha-v3-extended": "node examples/recaptcha_v3_extended_js_script.js",
    "example:turnstile": "node examples/cloudflare_turnstile.js",
    "example:challenge": "node examples/cloudflare_challenge_page.js",
    "example:image": "node examples/normal_captcha_screenshot.js",
    "example:image-canvas": "node examples/normal_captcha_canvas.js",
    "example:image-params": "node examples/normal_captcha_screenshot_params.js",
    "example:coordinates": "node examples/coordinates.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node scripts/live.js"
  },
  "dependencies": {
    "@captcha-solver-api/javascript-sdk": "^1.0.1",
    "dotenv": "^17.2.3",
    "puppeteer": "^25.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/captcha-solver-api/captcha-solver-puppeteer-javascript-examples"
  }
}
