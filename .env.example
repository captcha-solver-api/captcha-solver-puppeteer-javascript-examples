CAPTCHA_API_KEY=your_api_key
# Blank uses an official provider demo for reCAPTCHA v2 and Yandex SmartCaptcha.
# Other examples require a URL.
TARGET_URL=
HEADLESS=false
# Blank uses the Chrome for Testing downloaded by Puppeteer.
BROWSER_EXECUTABLE_PATH=
# Optional overrides when using your own pages:
SUCCESS_SELECTOR=
SUBMIT_SELECTOR=
CALLBACK_NAME=
RECAPTCHA_SITEKEY=
RECAPTCHA_ACTION=
RECAPTCHA_MIN_SCORE=0.3
YANDEX_SUCCESS_TEXT=Hello, user!
# Required for Tencent except the trigger, which can stay blank if the page opens it automatically.
TENCENT_TRIGGER_SELECTOR=
TENCENT_SUCCESS_SELECTOR=
# Required only for the two *_proxy.js examples; no default public proxy.
PROXY_TYPE=http
PROXY_ADDRESS=
PROXY_PORT=
PROXY_LOGIN=
PROXY_PASSWORD=
