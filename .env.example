CAPTCHA_API_KEY=your_api_key
# Blank uses the default demo for each example.
TARGET_URL=
HEADLESS=false
# Blank uses the Chrome for Testing downloaded by Puppeteer.
BROWSER_EXECUTABLE_PATH=
BROWSER_USER_AGENT=
PAGE_TIMEOUT_MS=60000
SOLVE_TIMEOUT_MS=180000
KEEP_OPEN_MS=3000
# Prints full solutions only when explicitly enabled. Never prints the API key.
PRINT_SOLUTION=false
# Optional overrides when using your own pages:
SUCCESS_SELECTOR=
SUBMIT_SELECTOR=
CALLBACK_NAME=
RECAPTCHA_SITEKEY=
RECAPTCHA_ACTION=
RECAPTCHA_MIN_SCORE=0.3
# Required only for the two *_proxy.js examples; no default public proxy.
PROXY_TYPE=http
PROXY_ADDRESS=
PROXY_PORT=
PROXY_LOGIN=
PROXY_PASSWORD=
