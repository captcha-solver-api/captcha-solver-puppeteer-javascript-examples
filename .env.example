CAPTCHA_API_KEY=your_api_key
# Replace target placeholders with pages that you are authorized to test.
RECAPTCHA_V2_TARGET_URL=https://www.google.com/recaptcha/api2/demo
RECAPTCHA_ENTERPRISE_TARGET_URL=https://example.com/page_with_recaptcha_v2_enterprise
RECAPTCHA_V3_TARGET_URL=https://example.com/page_with_recaptcha_v3
TURNSTILE_TARGET_URL=https://example.com/page_with_turnstile
TURNSTILE_CHALLENGE_TARGET_URL=https://example.com/page_with_turnstile_challenge
GEETEST_V3_TARGET_URL=https://example.com/page_with_geetest_v3
GEETEST_V4_TARGET_URL=https://example.com/page_with_geetest_v4
YANDEX_SMARTCAPTCHA_TARGET_URL=https://captcha-api.yandex.ru/demo
TENCENT_TARGET_URL=https://example.com/page_with_tencent_captcha
TENCENT_SCRIPT_URL=
HEADLESS=false
# Blank uses the Chrome for Testing downloaded by Puppeteer.
BROWSER_EXECUTABLE_PATH=
# Optional overrides when using your own pages:
SUCCESS_SELECTOR=
SUBMIT_SELECTOR=
CALLBACK_NAME=
RECAPTCHA_SITEKEY=
RECAPTCHA_ACTION=
RECAPTCHA_MIN_SCORE=0.3
YANDEX_SUCCESS_TEXT=Hello, user!
# The Tencent trigger can stay blank if the page opens the widget automatically.
TENCENT_TRIGGER_SELECTOR=
TENCENT_SUCCESS_SELECTOR=
